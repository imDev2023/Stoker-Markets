{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "launchpad-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "CLUSTER": "localnet",
    "RPC_URL": "http://127.0.0.1:8899",
    "PUBLIC_API_URL": "http://localhost:8791",
    "WEB_ORIGIN": "http://localhost:3100",
    "LAUNCHLAB_PROGRAM": "DRay6fNdQ5J82H7xV6uq2aV3mNrUZ1J4PgSKsWgptcm6",
    "CPMM_PROGRAM": "DRaycpLY18LhpbydsBWbVJtxpNv9oXPgjRSfpF2bWpYb",
    "PLATFORM_CONFIG": "",
    "GRADUATION_TARGET_LAMPORTS": "85000000000",
    // Raydium's crank migrates a sold-out curve within seconds; five minutes without it means something is wrong.
    "GRADUATION_ALERT_AFTER_SECONDS": "300",
    // The local chain's quote fixtures, priced as in tools/localnet LOCAL_QUOTE_PRICES_USD; mainnet uses "jupiter".
    "PRICE_SOURCE": "static",
    "QUOTE_PRICES_USD": "{\"So11111111111111111111111111111111111111112\":\"150\",\"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v\":\"1\",\"Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh\":\"180\",\"jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL\":\"2.5\"}"
  },
  // Scheduled jobs: the graduation watch every minute, the Quote Registry refresh (ADR 0005) every five. Locally,
  // `wrangler dev --test-scheduled` runs them on GET /__scheduled?cron=<the cron>, and on a bare GET both.
  "triggers": { "crons": ["* * * * *", "*/5 * * * *"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://launchpad:launchpad@127.0.0.1:5442/launchpad"
    }
  ],
  "r2_buckets": [{ "binding": "METADATA_BUCKET", "bucket_name": "launchpad-metadata" }]
}
