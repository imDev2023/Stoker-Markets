{
  "name": "launchpad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && node apps/web/scripts/type.mjs && node apps/web/scripts/contrast.mjs",
    "localnet": "pnpm --filter @launchpad/localnet start",
    "test:backend": "pnpm --filter @launchpad/tests-backend test",
    "test:ui": "pnpm --filter @launchpad/tests-ui test",
    "stand-ins": "pnpm --filter @launchpad/stack stand-ins"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
